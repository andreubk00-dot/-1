extends RefCounted
const Hotbar = preload("res://game/hotbar.gd")
func run(game: Node2D) -> void:
 var model=Hotbar.new()
 game._check(model.slots.size()==10 and model.slots[9]=="", "ten-slot hotbar includes free positions")
 game._check(model.assign(9,"axe") and model.slots[9]=="axe", "tools can occupy any hotbar slot")
 game._check(model.swap(0,9) and model.slots[0]=="axe" and model.slots[9]=="hand", "dragging between slots swaps assignments")
 game._check(model.assign(0,"") and model.slots[0]=="", "hotbar slots can be cleared")
 var snapshot: Array=model.slots.duplicate()
 game._check(not model.assign(20,"wood") and not model.assign(1,"unknown") and model.slots==snapshot, "invalid assignment cannot mutate hotbar")
 game._check(not model.restore(["axe"],0) and model.slots==snapshot, "invalid layout cannot partially overwrite hotbar")
 game._check(not model.restore(snapshot,-1) and not model.restore(snapshot,0.5), "active slot index is validated")
 game._check(model.restore(snapshot,8) and model.active==8, "hotbar preferences round trip")
 game.hotbar=model
 game.hotbar.assign(8,"wood")
 var wood: int=game.bag.wood
 game._sync_hotbar()
 game._check(game.selected==-1 and game.bag.wood==wood, "assigning materials does not consume or create inventory")
 game.hotbar.assign(6,"")
 game._begin_build("warehouse")
 game._check(game.building_mode and game.selected==-1 and game.hotbar.slots[8]=="wood", "temporary build tool does not overwrite custom layout")
 game._save_game()
 game.hotbar=Hotbar.new()
 game._check(game._load_game() and game.hotbar.slots[8]=="wood" and game.hotbar.active==8, "save restores custom layout and active slot")
 game.hotbar.assign(8,"")
 game._sync_hotbar()
 game._check(game.selected==0, "empty slot behaves as free hands")
 game.effects.start(4,game.player,Vector2i(20,18),"tree")
 var particles: int=game.particles.size()
 game.effects.update(0.3,game)
 game._check(game.effects.impact and game.particles.size()==particles+7, "work animation emits impact at the strike phase")
 game.effects.update(0.01,game)
 game._check(game.particles.size()==particles+7, "work animation cannot repeat impact emission")
 game.effects.update(1.0,game)
 game._check(not game.effects.active(), "work animation ends and releases movement")
 game.hud.show_inventory()
 game._check(game.modal.visible and game.hud.view=="inventory" and game.hud.inventory_grid.get_child_count()==36, "inventory window shows all items and empty cells")
 game.hud.inspect_item("seeds")
 game.hud.slot_pressed(9)
 game._check(game.hotbar.slots[9]=="seeds" and game.bag.seeds==0, "touch-friendly inventory assignment does not duplicate items")
 game.modal.hide()

 game.player=Vector2(19*24,14*24)
 game.facing=Vector2(1,1).normalized()
 game._check(game._front_cell()==Vector2i(20,15), "diagonal work targets the neighboring cell ahead")

 var layout=load("res://game/inventory_layout.gd").new()
 layout.reconcile({"wood":5,"seeds":3})
 var origin: int=layout.slots.find("wood")
 layout.swap(origin,23)
 layout.reconcile({"wood":5,"seeds":3})
 game._check(layout.slots[23]=="wood" and layout.slots.count("wood")==1, "inventory stacks can move freely without duplication")
 layout.reconcile({"wood":0,"seeds":3})
 game._check(not layout.slots.has("wood") and layout.slots.has("hoe"), "empty material stacks disappear while tools remain")
 var invalid: Array=layout.slots.duplicate()
 invalid[22]="hoe"
 game._check(not layout.restore(invalid), "inventory rejects duplicate stack identities")
 game.inventory_layout=layout
 game._save_game()
 var saved_day: int=game.day
 var f:=FileAccess.open(game.save_path,FileAccess.READ)
 var prefs: Dictionary=JSON.parse_string(f.get_as_text())
 f.close()
 prefs.hotbar=["invalid"]
 prefs.inventory_layout=["invalid"]
 var out:=FileAccess.open(game.save_path,FileAccess.WRITE)
 out.store_string(JSON.stringify(prefs))
 out.close()
 game._check(game._load_game() and game.day==saved_day and game.hotbar.slots.size()==10 and game.inventory_layout.slots.size()==36, "invalid UI preferences recover without resetting farm progress")
